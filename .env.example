# Public URL of this gateway. Put HTTPS in front of 127.0.0.1:8080.
PUBLIC_BASE_URL=https://pay.example.com

# Exact HTTPS origin(s) of the single New API instance, comma-separated.
NEW_API_ALLOWED_ORIGINS=https://api.example.com

# Generate independent random values; do not reuse provider secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-password
EPAY_PID=newapi-main
EPAY_KEY=replace-with-at-least-32-random-characters

# Host directory mounted read-only at /run/secrets inside the gateway container.
# Relative paths are resolved from the directory containing compose.yaml.
SECRETS_HOST_DIR=./secrets

# Optional limits and read-only admin order page.
MAX_ORDER_CENTS=10000000
ORDER_TTL=30m
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Alipay computer website application.
ALIPAY_APP_ID=
# These are container paths under /run/secrets. Use the exact downloaded
# application certificate filename when it contains the AppID.
ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay/app_private_key.pem
ALIPAY_APP_PUBLIC_CERT_FILE=/run/secrets/alipay/appCertPublicKey_APPID.crt
ALIPAY_ROOT_CERT_FILE=/run/secrets/alipay/alipayRootCert.crt
ALIPAY_PUBLIC_CERT_FILE=/run/secrets/alipay/alipayCertPublicKey_RSA2.crt

# WeChat Pay Native direct merchant.
WECHAT_APP_ID=
WECHAT_MERCHANT_ID=
WECHAT_SERIAL_NUMBER=
WECHAT_API_V3_KEY=
# Keep the PUB_KEY_ID_ prefix when the merchant platform supplies one.
WECHAT_PUBLIC_KEY_ID=
WECHAT_PRIVATE_KEY_FILE=/run/secrets/wechat/apiclient_key.pem
WECHAT_PUBLIC_KEY_FILE=/run/secrets/wechat/wechatpay_public_key.pem

